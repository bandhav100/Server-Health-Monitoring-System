# =====================================================

# SHMS Jenkins Environment Variables

# =====================================================

# GitHub

GITHUB_REPO=bandhav100/Server-Health-Monitoring-System
GITHUB_BRANCH=main

# Python Backend

PYTHON_VERSION=3.13
FLASK_ENV=production

# Docker

DOCKER_COMPOSE_FILE=docker-compose.yml
