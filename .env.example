# ==============================================================================
# SHMS - Server Health Monitoring System
# Environment Configuration Template (.env.example)
#
# Copy this file to .env (or ackend/.env) and populate the values.
# DO NOT commit real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FLASK BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-secure-random-32-character-string
JWT_SECRET_KEY=change-me-to-a-secure-random-jwt-secret-key

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# Support either discrete DB_* parameters OR full DATABASE_URL connection string
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shms
DB_USER=postgres
DB_PASSWORD=your_secure_db_password

# Optional direct database connection string (overrides DB_* if provided):
# DATABASE_URL=postgresql://postgres:your_secure_db_password@postgres:5432/shms

# ------------------------------------------------------------------------------
# 3. CORS CONFIGURATION
# Comma-separated list of allowed origins (e.g. frontend domain / IP)
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. MONITORING & TELEMETRY SERVICES
# ------------------------------------------------------------------------------
# Prometheus server API endpoint
PROMETHEUS_URL=http://prometheus:9090

# Windows Exporter endpoint (host-level hardware agent)
WINDOWS_EXPORTER_URL=http://host.docker.internal:9182/

# LibreHardwareMonitor scrape instance label in Prometheus
LHM_INSTANCE=host.docker.internal:8085

# Grafana instance endpoints & API access
GRAFANA_URL=http://grafana:3000
GRAFANA_API_URL=http://grafana:3000/api
GRAFANA_API_TOKEN=

# ------------------------------------------------------------------------------
# 5. PREDICTION / ML SERVICE
# Endpoint of the external or containerized machine learning / prediction service
# ------------------------------------------------------------------------------
PREDICTION_SERVICE_URL=http://prediction-service:8000
# Alternative alias supported:
# ML_SERVICE_URL=http://prediction-service:8000

# ------------------------------------------------------------------------------
# 6. INITIAL ADMIN SEED CREDENTIALS
# Used on first startup to initialize default platform administrator
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin@shms.local
ADMIN_PASSWORD=change-me-admin-password

# ------------------------------------------------------------------------------
# 7. LOGGING & FILE STORAGE PATHS
# Container directory to store persistent application logs
# ------------------------------------------------------------------------------
LOG_DIR=/var/log/shms

# ------------------------------------------------------------------------------
# 8. FRONTEND (Vite / React)
# ------------------------------------------------------------------------------
# API base URL for client requests (leave /api for same-host reverse proxy)
VITE_API_BASE_URL=/api

# Backend upstream server for Vite development proxy
VITE_BACKEND_URL=http://backend:5000

# Embedded Grafana dashboard base URL for client iframe
VITE_GRAFANA_URL=http://localhost:3000/d/ad5x2s5/shms

# Frontend dev server port
VITE_PORT=5173
VITE_HOST=0.0.0.0
